                <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
                  <stringProp name="cacheKey">true</stringProp>
                  <stringProp name="filename"></stringProp>
                  <stringProp name="parameters"></stringProp>
                  <stringProp name="script">import java.time.LocalDate
// Get today&apos;s date (end date)
def endDate = LocalDate.now()
// Get date 6 months ago (begin date)
def beginDate = endDate.minusMonths(6)
// Extract separate day, month, year parts
def C_bday = String.format(&quot;%02d&quot;, beginDate.getDayOfMonth())
def C_bmon = String.format(&quot;%02d&quot;, beginDate.getMonthValue())
def C_byear = String.valueOf(beginDate.getYear())
def C_eday = String.format(&quot;%02d&quot;, endDate.getDayOfMonth())
def C_emon = String.format(&quot;%02d&quot;, endDate.getMonthValue())
def C_eyear = String.valueOf(endDate.getYear())
// Store as JMeter variables
vars.put(&quot;C_bday&quot;, C_bday)
vars.put(&quot;C_bmon&quot;, C_bmon)
vars.put(&quot;C_byear&quot;, C_byear)
vars.put(&quot;C_eday&quot;, C_eday)
vars.put(&quot;C_emon&quot;, C_emon)
vars.put(&quot;C_eyear&quot;, C_eyear)
// Debug log (visible in JMeter console)
log.info(&quot;From Date =&gt; &quot; + C_bday + &quot;-&quot; + C_bmon + &quot;-&quot; + C_byear)
log.info(&quot;To Date   =&gt; &quot; + C_eday + &quot;-&quot; + C_emon + &quot;-&quot; + C_eyear)
</stringProp>
                  <stringProp name="scriptLanguage">groovy</stringProp>
                </JSR223PreProcessor>
