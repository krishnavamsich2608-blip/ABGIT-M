                  <stringProp name="script">def AccountNo   = vars.get(&quot;C_Accno&quot;)
def AccBalance  = vars.get(&quot;C_Balance&quot;) 

def file = new File(&quot;D:/JMeter/AS_File.csv&quot;)
if (!file.exists()) {
    file.write(&quot;AccountNo,AccBalance\n&quot;, &quot;UTF-8&quot;)
}
file.append(&quot;\&quot;${AccountNo}\&quot;,\&quot;${AccBalance}\&quot;\n&quot;,&quot;UTF-8&quot;);</stringProp>
